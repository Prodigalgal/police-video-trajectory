FROM eclipse-temurin:21-jre-noble
ARG APP_VERSION
LABEL org.opencontainers.image.title="视频线索检索 Core" org.opencontainers.image.version=$APP_VERSION
WORKDIR /app
COPY services/core_api/build/libs/police-video-core-api-${APP_VERSION}.jar /app/app.jar
USER 10001:10001
ENTRYPOINT ["java","-jar","/app/app.jar"]
